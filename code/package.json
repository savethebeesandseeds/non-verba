{
  "name": "@non-verba/project",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Cooperation and assignment protocols, evidence capture and independent verification",
  "exports": "./protocol/cooperation.mjs",
  "scripts": {
    "test:model:operator-face": "node tools/run-tests.mjs face_model",
    "test:operator-face": "cargo test --locked -p nonverba-core face_identity && cargo test --locked -p nonverba-core authentication && cargo test --locked -p nonverba-core registration && cargo test --locked -p nonverba-core work_privacy && node --test test/face-workflow-tests.mjs test/authentication-workflow-tests.mjs test/registration-workflow-tests.mjs test/work-privacy-controller-tests.mjs test/test-suites-tests.mjs",
    "test:browser:operator-face": "node tools/build-web.mjs && node test/operator-face-browser-tests.mjs",
    "test:registration": "cargo test --locked -p nonverba-core registration && node --test test/registration-workflow-tests.mjs test/test-suites-tests.mjs",
    "test:browser:registration": "node tools/build-web.mjs && node test/registration-browser-tests.mjs",
    "test:authentication-privacy": "cargo test --locked -p nonverba-core authentication && cargo test --locked -p nonverba-core work_privacy && node --test test/authentication-workflow-tests.mjs test/work-privacy-controller-tests.mjs test/test-suites-tests.mjs",
    "test:browser:authentication-privacy": "node tools/build-web.mjs && node test/authentication-privacy-browser-tests.mjs",
    "build:web": "node tools/build-web.mjs",
    "stage:android": "node tools/stage-android.mjs",
    "serve": "node tools/serve.mjs",
    "test:core": "cargo test --locked --workspace",
    "test:browser:camera": "node test/browser-tests.mjs",
    "test:browser:audio": "node test/audio-browser-tests.mjs",
    "test:browser:audio:acceptance": "node test/audio-acceptance-browser-tests.mjs",
    "test:audio:adapters": "node --test test/audio-adapter-tests.mjs",
    "test:audio:worklet": "node --test test/audio-worklet-tests.mjs",
    "test:camera:adapters": "node --test test/camera-adapter-tests.mjs",
    "test:native-audio:adapters": "node --test test/native-audio-adapter-tests.mjs",
    "test:location:adapters": "node --test test/location-adapter-tests.mjs",
    "test:enrollment:adapters": "node --test test/key-enrollment-adapter-tests.mjs",
    "test:browser:location": "node test/location-browser-tests.mjs",
    "test:browser:raw-gnss": "node test/raw-gnss-browser-tests.mjs",
    "test:browser:rinex": "node test/rinex-browser-tests.mjs",
    "test:browser:native-camera": "node test/native-camera-browser-tests.mjs",
    "test:browser:native-audio": "node test/native-audio-browser-tests.mjs",
    "test:browser:camera-location": "node test/camera-location-browser-tests.mjs",
    "test:browser:live-location": "node test/live-location-browser-tests.mjs",
    "test:browser:trust": "node test/trust-browser-tests.mjs",
    "test:browser:evidence-session": "node test/evidence-session-browser-tests.mjs",
    "test:browser:enrollment": "node test/key-enrollment-browser-tests.mjs",
    "build:wasm": "node tools/build-wasm.mjs",
    "test": "node --run test:rust && node --run test:cooperation && node --run test:javascript",
    "test:rust": "cargo test --locked --workspace",
    "test:browser": "node tools/build-wasm.mjs && node test/browser-smoke.mjs",
    "test:simulator": "node tools/build-wasm.mjs && node test/simulator-browser.mjs",
    "serve:web": "node tools/serve-simulator.mjs",
    "serve:simulator": "node tools/serve-simulator.mjs",
    "check:rust": "cargo clippy --locked --workspace --all-targets -- -D warnings",
    "example": "node tools/build-wasm.mjs && node examples/cooperation.mjs",
    "test:cooperation": "node tools/run-tests.mjs cooperation",
    "test:javascript": "node tools/run-tests.mjs javascript",
    "test:unit": "node tools/run-tests.mjs unit",
    "test:evidence": "node tools/run-tests.mjs evidence",
    "test:transport": "node tools/run-tests.mjs transport",
    "test:requests": "cargo test --locked -p nonverba-requests",
    "test:disputes": "cargo test --locked -p nonverba-disputes"
  },
  "engines": {
    "node": ">=22"
  }
}
