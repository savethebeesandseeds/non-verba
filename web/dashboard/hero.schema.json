{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Non Verba Hero with Goals and Milestones version 2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "number", "title", "summary", "updatedAt", "goals"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"$ref": "#/$defs/id"},
    "number": {"type": "integer", "minimum": 1, "maximum": 100},
    "title": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"}, "updatedAt": {"$ref": "#/$defs/date"},
    "goals": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/goal"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "text": {"type": "string", "pattern": "\\S"},
    "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "goal": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "milestones"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"},
        "milestones": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/milestone"}}
      }
    },
    "milestone": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"},
        "status": {"enum": ["proposed", "ready", "in_progress", "blocked", "done"]},
        "description": {"$ref": "#/$defs/text"},
        "owner": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
        "updatedAt": {"$ref": "#/$defs/date"},
        "completedAt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
        "acceptance": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/text"}},
        "evidence": {"type": "array", "maxItems": 2000, "items": {"type": "object", "additionalProperties": false, "required": ["label", "path"], "properties": {"label": {"$ref": "#/$defs/text"}, "path": {"type": "string", "maxLength": 500, "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|#|$))[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*(?:#[a-zA-Z0-9_-]+)?$"}}}},
        "dependsOn": {"type": "array", "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "done"}}}, "then": {"required": ["acceptance", "evidence"], "properties": {"acceptance": {"minItems": 1}, "evidence": {"minItems": 1}}}, "else": {"properties": {"completedAt": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "blocked"}}}, "then": {"required": ["description"]}}
      ]
    }
  }
}
