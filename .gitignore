# Reproducible caches and dependency trees, including nested workspaces.
target/
node_modules/
.tools/
.toolchain/
.gradle/
.kotlin/
.cxx/
__pycache__/
*.py[cod]

# Generated packages, local records, and release staging.
/target/
/dist/
/pkg/
/artifacts/
/local-archive/
/code/pkg/
/code/artifacts/
/code/dist/
/web/dist/
/code/android/**/build/
/code/android/app/src/main/assets/web/
/code/android/app/src/main/assets/nonverba-license/
/code/android/app/src/main/jniLibs/
/code/android/local.properties
/reviews/
*.apk
*.aab

# Local secrets and machine state; authored examples remain trackable.
*.keystore
*.jks
*.log
.env
.env.*
!.env.example
.DS_Store
